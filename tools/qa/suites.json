  "electron-unit": {"requires": ["electron-build"], "paths": ["app/electron/", "protocol/ui-bridge/", "protocol/C6-agentd-api/fixtures/", "protocol/C9-agentd-process/examples/", "agent/agentd/", "app/Resources/agentd_launcher.py", "protocol/character-library/fixtures/empty-library/", "tools/platform/agentd-python.sh", "web/tests/unit/shape.ts", "web/src/bridge/protocol.ts", "protocol/C11-components/validate.py", "protocol/C11-components/examples/", "tools/release/component_manifest.py", "tools/release/flip_fuses.mjs", "protocol/C3-host-ipc/examples/", "protocol/C12-platform-helper/", "app/helpers/mac/", "protocol/C10-shared-files/examples/", "protocol/C1-agent-events/fixtures/"], "run": ["node", "test/count.mjs", "ELECTRON-UNIT"], "cwd": "app/electron", "parse": "tail1"},
  "electron-e2e": {"requires": ["electron-build"], "paths": ["app/electron/", "protocol/ui-bridge/", "app/Tests/Fixtures/HeadlessE2E/", "app/Resources/agentd_launcher.py", "agent/agentd/", "characters/sample-library/", "protocol/character-library/fixtures/empty-library/", "tools/platform/agentd-python.sh", "protocol/C2-speech-stream/examples/ok-basic.ndjson", "protocol/C12-platform-helper/"], "run": ["bash", "-c", "out=$(AAC_ELECTRON_E2E=1 node --test --test-force-exit --test-reporter=tap test/e2e-headless.test.ts 2>&1); rc=$?; printf '%s\\n' \"$out\"; pass=$(printf '%s\\n' \"$out\" | sed -n 's/^# pass //p'); fail=$(printf '%s\\n' \"$out\" | sed -n 's/^# fail //p'); skip=$(printf '%s\\n' \"$out\" | sed -n 's/^# skipped //p'); echo \"ELECTRON-E2E ${pass:-0} passed ${fail:-0} failed ${skip:-0} skipped\"; [ $rc -eq 0 ] && [ \"${pass:-0}\" -ge 10 ] && [ \"${skip:-0}\" -eq 0 ]"], "cwd": "app/electron", "nice": true, "parse": "tail1"},
