  "web-build": {"paths": ["web/", "protocol/"], "requires": ["web-node", "web-ci"], "run": ["bash", "-c", "npx vite build --mode app --outDir \"$1\" --emptyOutDir && [ -f \"$1/main.html\" ] && [ -f \"$1/stack.html\" ] && ! grep -rl 'data:font' \"$1\"", "_", "{logs}/dist"], "cwd": "web", "env": {"NO_COLOR": "1"}, "parse": "exit", "line": {"pass": "WEB-BUILD ok", "fail": "WEB-BUILD fail"}},
