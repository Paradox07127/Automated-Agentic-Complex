  "scripts-syntax": {"paths": ["app/build_app.sh", "app/package_release.sh"], "run": ["bash", "-c", "bad=0; for s in \"$@\"; do bash -n \"$s\" || bad=1; done; exit $bad", "_", "{repo}/app/build_app.sh", "{repo}/app/package_release.sh"], "parse": "build", "line": {"pass": "T-SCRIPTS PASS", "fail": "T-SCRIPTS FAIL"}},
