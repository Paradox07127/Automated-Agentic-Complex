{
  "manifest_version": 3,
  "name": "Agentic Complex",
  "version": "0.2.0",
  "description": "为本机 Companion 提供网站时长、滚动和播放状态；网页文字按分享开关读取，不在无痕窗口运行。",
  "key": "",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "alarms",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
